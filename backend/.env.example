DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@localhost:5432/dmhr_portal?schema=public"
PORT=4000
NODE_ENV=development
JWT_SECRET="change-me-to-a-long-random-string"
CORS_ORIGIN="http://localhost:3000"
FRONTEND_URL="http://localhost:3000"
STORAGE_ROOT="./storage"
# SMTP mailbox password encryption (AES-256-GCM). Generate yourself — never commit a real value:
#   openssl rand -base64 32
# Required in production. Paste into hosting encrypted env + your password manager backup.
SMTP_SECRET_KEY=
# Proxy hops in front of the API (Render/DO ≈ 1). Used for rate limits + login audit IP.
TRUST_PROXY_HOPS=1
# Optional auth rate-limit ceilings (15-minute window). Defaults are fine for most deploys.
# RATE_LIMIT_LOGIN_IP_MAX=30
# RATE_LIMIT_LOGIN_EMAIL_MAX=10
# RATE_LIMIT_INVITE_IP_MAX=60
# RATE_LIMIT_SET_PASSWORD_IP_MAX=20
# RATE_LIMIT_SET_PASSWORD_TOKEN_MAX=10
# RATE_LIMIT_CHANGE_PASSWORD_MAX=10
# Access link lifetimes (invite = first set-password; reset = after password was set)
INVITE_TOKEN_TTL_HOURS=72
RESET_TOKEN_TTL_MINUTES=20
# Cases shared inbox is configured in Admin → Settings → SMTP (casesNotifyEmail),
# default case@dmhrgroup.com — always CC'd on client case submit/reply/update.
