DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@localhost:5432/dmhr_portal?schema=public"
PORT=4000
NODE_ENV=development
JWT_SECRET="change-me-to-a-long-random-string"
CORS_ORIGIN="http://localhost:3000"
FRONTEND_URL="http://localhost:3000"
STORAGE_ROOT="./storage"
# SMTP mailbox password encryption (AES-256-GCM). Generate yourself — never commit a real value:
#   openssl rand -base64 32
# Required in production. Paste into hosting encrypted env + your password manager backup.
SMTP_SECRET_KEY=
# Cases shared inbox is configured in Admin → Settings → SMTP (casesNotifyEmail),
# default case@dmhrgroup.com — always CC'd on client case submit/reply/update.
