DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@localhost:5432/dmhr_portal?schema=public"
PORT=4000
NODE_ENV=development
# Use a long random string. Production requires ≥ 32 characters.
# After deploying token sessions (#5), rotate once on the host to force global re-login:
#   openssl rand -base64 48
JWT_SECRET="change-me-to-a-long-random-string-at-least-32-chars"
CORS_ORIGIN="http://localhost:3000"
FRONTEND_URL="http://localhost:3000"
STORAGE_ROOT="./storage"
# File encryption at rest (#2). Generate yourself — never commit a real value:
#   openssl rand -base64 32
# Required in production. Backup this key — without it encrypted files cannot be read.
FILE_SECRET_KEY=
# local (default) or spaces (S3-compatible / DigitalOcean Spaces)
STORAGE_DRIVER=local
# UPLOAD_TEMP_DIR=
# UPLOAD_MAX_CONCURRENT_IP=5
# SPACES_ENDPOINT=
# SPACES_REGION=nyc3
# SPACES_BUCKET=
# SPACES_KEY=
# SPACES_SECRET=
# SPACES_PREFIX=dmhr
# SMTP mailbox password encryption (AES-256-GCM). Generate yourself — never commit a real value:
#   openssl rand -base64 32
# Required in production. Paste into hosting encrypted env + your password manager backup.
SMTP_SECRET_KEY=
# Proxy hops in front of the API (Render/DO ≈ 1). Used for rate limits + login audit IP.
TRUST_PROXY_HOPS=1
# Optional auth rate-limit ceilings (15-minute window). Defaults are fine for most deploys.
# RATE_LIMIT_LOGIN_IP_MAX=30
# RATE_LIMIT_LOGIN_EMAIL_MAX=10
# RATE_LIMIT_INVITE_IP_MAX=60
# RATE_LIMIT_SET_PASSWORD_IP_MAX=20
# RATE_LIMIT_SET_PASSWORD_TOKEN_MAX=10
# RATE_LIMIT_CHANGE_PASSWORD_MAX=10
# RATE_LIMIT_REFRESH_IP_MAX=120
# Access link lifetimes (invite = first set-password; reset = after password was set)
INVITE_TOKEN_TTL_HOURS=72
RESET_TOKEN_TTL_MINUTES=20
# Login session (#5): short access JWT + refresh; idle + absolute caps
JWT_ACCESS_TTL_MINUTES=15
SESSION_IDLE_MINUTES=30
SESSION_ABSOLUTE_HOURS=8
# Audit trail retention (~6 years). Only the retention job may delete aged rows.
AUDIT_RETENTION_DAYS=2190
# Cases shared inbox is configured in Admin → Settings → SMTP (casesNotifyEmail),
# default case@dmhrgroup.com — always CC'd on client case submit/reply/update.
